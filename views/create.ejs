<!--Including header content from the header partial-->
<%- include ('partials/header') %>
<div class="card bg-dark text-white">
  <div class="card-body">
    <h4 class="card-title">CampusFind</h4>
  </div>
</div>

<container class="row offset-md-3"></container>
<div class="container mb-5 pb-5"> <!--Adds margins and padding to the bottom of the container div, Bootstrap styling-->
    <div class="row mb-4">
        <div class="offset-md-3 col-md-6 text-center">
            <img src="/stylesheets/Images/image.jpg" class="mx-auto d-block"> 
            <a href="/items" class="btn btn-primary" role="button"> <i class="fas fa-arrow-left"></i> Back to Lost Items</a>
        </div>
      </div>
            <h1>Create A Lost Item</h1>
            <form class="form" method="post"> <!--Creating the form that will be used to create lost item reports-->
                <div class="form-group"> <!--Using Bootstrap styling here as well -->
                    <label for="nameTextField">Your Name</label>
                    <input type="text" class="form-control" id="reportedBy"
                    placeholder="Enter your name"
                    name="reportedBy" required>
                </div>
                <div class="form-group">
                    <label for="itemTextField">Item Name</label>
                    <input type="text" class="form-control" id="itemName"
                    placeholder="Enter the item name"
                    name="itemName" required>
                </div>
                <div class="form-group">
                    <label for="descriptionTextField">Item Description</label>
                    <textarea type="text" class="form-control" id="description"
                    placeholder="Enter the item description"
                    name="description" required></textarea>
                </div>
                <div class="form-group">
                    <label for="lastSeenTextField">Last Seen</label>
                    <input type="text" class="form-control" id="lastSeen"
                    placeholder="Where was this item last seen?"
                    name="lastSeen" required>
                </div>
                <div class="form-group">
                    <label for="dateTextField">Date</label>
                    <input type="date" class="form-control" id="date"
                    placeholder="Enter today's date"
                    name="date" required></textarea>
                </div>
                <div class="form-group">
                    <label for="contactTextField">Email</label>
                    <input type="email" class="form-control" id="contact"
                    placeholder="Enter your school email"
                    name="contact" required>
                </div>
                <!--Submit and cancel buttons (Bootstrap)-->
                <button class="btn btn-primary" type="submit">
                    <!--Icons from fontawesome-free-->
                    <i class="fas fa-edit"></i> Submit
                </button>
                <a href="/home" class="btn btn-warning">
                    <i class="fas fa-undo"></i>Cancel
                </a>
            </form>
        </div>
    </div>
</div>

<!--Including the content from footer.ejs partial-->
<%- include ('partials/footer') %>
